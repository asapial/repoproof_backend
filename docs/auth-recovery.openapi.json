{
  "openapi": "3.1.0",
  "info": {
    "title": "RepoProof account recovery",
    "version": "1.0.0",
    "description": "Configured native password recovery and public capability. No external delivery or email verification claim. Fragment links are valid once for 15 minutes; completion revokes all sessions. Default ENABLE_SMTP=false returns 503 for recovery operations."
  },
  "paths": {
    "/api/v1/auth-capabilities": {
      "get": {
        "operationId": "authCapabilities",
        "security": [],
        "description": "Public configuration only; does not assert delivery, membership or a provider entitlement. No query accepted; Cache-Control: no-store.",
        "responses": {
          "200": {
            "description": "Configured capability",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthCapabilities"
                }
              }
            }
          },
          "400": {
            "description": "Invalid query",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/V1Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/request-password-reset": {
      "post": {
        "operationId": "requestPasswordReset",
        "security": [],
        "description": "Requires trusted Origin and bounded JSON. redirectTo must be absent or the exact configured FRONTEND_URL/reset-password. Registered/unknown addresses return the same generic response. Mail is sent asynchronously over certificate-verified TLS. 5 requests/client/15 minutes, 3/address/15 minutes, 30 global/minute plus shared auth ceiling; keys HMAC-hashed. Never returns a token.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PasswordResetRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Generic non-enumerating acknowledgement",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PasswordResetRequested"
                }
              }
            }
          },
          "400": {
            "description": "Safe native auth error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NativeError"
                }
              }
            }
          },
          "403": {
            "description": "Safe native auth error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NativeError"
                }
              }
            }
          },
          "429": {
            "description": "Safe native auth error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NativeError"
                }
              }
            }
          },
          "500": {
            "description": "Safe native auth error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NativeError"
                }
              }
            }
          },
          "503": {
            "description": "Safe native auth error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NativeError"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/reset-password": {
      "post": {
        "operationId": "resetPassword",
        "security": [],
        "description": "Requires trusted Origin, JSON token/newPassword and no query. Atomic single-use token consumption, session revocation and password write in PostgreSQL. Does not create a session. 10 requests/client/5 minutes plus auth ceiling. Stored reset identifiers are hashed. GET URL-token redirect is unsupported; the application mails FRONTEND_URL/reset-password#token=... directly.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PasswordReset"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Password changed; sign in again",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PasswordResetCompleted"
                }
              }
            }
          },
          "400": {
            "description": "Safe native auth error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NativeError"
                }
              }
            }
          },
          "403": {
            "description": "Safe native auth error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NativeError"
                }
              }
            }
          },
          "429": {
            "description": "Safe native auth error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NativeError"
                }
              }
            }
          },
          "500": {
            "description": "Safe native auth error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NativeError"
                }
              }
            }
          },
          "503": {
            "description": "Safe native auth error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NativeError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AuthCapabilities": {
        "type": "object",
        "properties": {
          "passwordReset": {
            "type": "object",
            "properties": {
              "enabled": {
                "type": "boolean"
              }
            },
            "required": [
              "enabled"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "passwordReset"
        ],
        "additionalProperties": false
      },
      "PasswordResetRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 320,
            "format": "email",
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          },
          "redirectTo": {
            "type": "string",
            "maxLength": 2048
          }
        },
        "required": [
          "email"
        ],
        "additionalProperties": false
      },
      "PasswordReset": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "pattern": "^[A-Za-z0-9]{24}$"
          },
          "newPassword": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128
          }
        },
        "required": [
          "token",
          "newPassword"
        ],
        "additionalProperties": false
      },
      "PasswordResetRequested": {
        "type": "object",
        "properties": {
          "status": {
            "type": "boolean",
            "const": true
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        },
        "required": [
          "status",
          "message"
        ],
        "additionalProperties": false
      },
      "PasswordResetCompleted": {
        "type": "object",
        "properties": {
          "status": {
            "type": "boolean",
            "const": true
          }
        },
        "required": [
          "status"
        ],
        "additionalProperties": false
      },
      "V1Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]*$"
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "requestId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9_-]+$"
              }
            },
            "required": [
              "code",
              "message",
              "requestId"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      },
      "NativeError": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "message"
        ]
      }
    }
  }
}
