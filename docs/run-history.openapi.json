{
  "openapi": "3.1.0",
  "info": {
    "title": "RepoProof owned run history",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/runs": {
      "get": {
        "operationId": "listOwnedRuns",
        "summary": "Read current user's stored run history and counts",
        "description": "Server-resolved session ownership and fixed curated-fixture scope apply to every row. Stored run state is not execution or verdict proof. Read-only, no-store, bounded to 25 rows. Cursor is canonical base64url JSON containing createdAt and id; ownership is always enforced independently. Null-owned and unsupported records are excluded. No report/evidence/lease/model/storage fields are returned.",
        "security": [
          {
            "SessionCookie": []
          },
          {
            "SecureSessionCookie": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "string",
              "pattern": "^(?:[1-9]|1[0-9]|2[0-5])$",
              "default": "10"
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "^[A-Za-z0-9_-]+$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Owned persisted records; an empty database returns actual zero counts and an empty list",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunHistory"
                }
              }
            }
          },
          "400": {
            "description": "Invalid or extra query/cursor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Session required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Shared owner/global quota exceeded; Retry-After: 60",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Internal authentication failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Database/projection unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "SessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "better-auth.session_token",
        "description": "Local HttpOnly session cookie; managed by native auth routes"
      },
      "SecureSessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Secure-better-auth.session_token",
        "description": "Secure production HttpOnly session cookie; managed by native auth routes"
      }
    },
    "schemas": {
      "RunHistory": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "scope": {
            "type": "string",
            "const": "OWNED_RUN_RECORDS"
          },
          "summary": {
            "type": "object",
            "properties": {
              "total": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "running": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "awaitingApproval": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "completed": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "failed": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "cancelled": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "repositories": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "submittedIssues": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "total",
              "running",
              "awaitingApproval",
              "completed",
              "failed",
              "cancelled",
              "repositories",
              "submittedIssues"
            ],
            "additionalProperties": false
          },
          "runs": {
            "maxItems": 25,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9_-]+$"
                },
                "repository": {
                  "type": "string",
                  "const": "asapial/repoproof_backend"
                },
                "issueNumber": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "issueTitle": {
                  "type": "string",
                  "maxLength": 320
                },
                "baseSha": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                },
                "state": {
                  "type": "string",
                  "enum": [
                    "CREATED",
                    "ANALYZING",
                    "AWAITING_APPROVAL",
                    "QUEUED",
                    "PREPARING",
                    "GENERATING_REPRO",
                    "BASELINING",
                    "PATCHING",
                    "VERIFYING",
                    "REPORTING",
                    "COMPLETED",
                    "FAILED",
                    "CANCELLED"
                  ]
                },
                "createdAt": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
                },
                "startedAt": {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "date-time",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "finishedAt": {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "date-time",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "id",
                "repository",
                "issueNumber",
                "issueTitle",
                "baseSha",
                "state",
                "createdAt",
                "startedAt",
                "finishedAt"
              ],
              "additionalProperties": false
            }
          },
          "nextCursor": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "scope",
          "summary",
          "runs",
          "nextCursor"
        ],
        "additionalProperties": false
      },
      "Error": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]*$"
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "requestId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9_-]+$"
              }
            },
            "required": [
              "code",
              "message",
              "requestId"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      }
    }
  }
}
