# SAFE MVP core. Supply real local/staging values outside Git.
NODE_ENV=development
PORT=5000
DATABASE_URL=
# CLI-only direct migration-owner URL; do not install this secret in Vercel runtime.
# DIRECT_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000
# Optional active session durations (seconds); update age must be below expiry.
BETTER_AUTH_SESSION_TOKEN_EXPIRES_IN=604800
BETTER_AUTH_SESSION_TOKEN_UPDATE_AGE=86400
# Explicitly disabled integrations need no credentials and perform no calls.
ENABLE_OPENROUTER=false
ENABLE_META=false
ENABLE_SMTP=false
# Optional email ownership confirmation; also requires approved SMTP above.
# Existing sign-in remains compatible; confirmation never signs in or edits email.
ENABLE_EMAIL_VERIFICATION=false
# Password recovery needs an approved SMTP account. No delivery occurs while off.
# All SMTP connections require TLS with certificate verification (465 implicit
# TLS by default, other ports require STARTTLS). No plaintext option is exposed.
# EMAIL_SENDER_SMTP_USER=
# EMAIL_SENDER_SMTP_PASS=
# EMAIL_SENDER_SMTP_HOST=
# EMAIL_SENDER_SMTP_PORT=587
# EMAIL_SENDER_SMTP_FROM=accounts@example.com
# EMAIL_SENDER_SMTP_SECURE=false
ENABLE_GOOGLE_OAUTH=false
ENABLE_CLOUDINARY=false
ENABLE_LEGACY_JWT=false
# Internal administrative smoke only; no public route. Keep disabled at release.
SANDBOX_SMOKE_ENABLED=false
