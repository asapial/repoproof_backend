# SAFE MVP core. Supply real local/staging values outside Git.
NODE_ENV=development
PORT=5000
DATABASE_URL=
# CLI-only direct migration-owner URL; do not install this secret in Vercel runtime.
# DIRECT_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000
# Optional active session durations (seconds); update age must be below expiry.
BETTER_AUTH_SESSION_TOKEN_EXPIRES_IN=604800
BETTER_AUTH_SESSION_TOKEN_UPDATE_AGE=86400
# Explicitly disabled integrations need no credentials and perform no calls.
ENABLE_OPENROUTER=false
ENABLE_META=false
ENABLE_SMTP=false
ENABLE_GOOGLE_OAUTH=false
ENABLE_CLOUDINARY=false
ENABLE_LEGACY_JWT=false
